# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill it in. .env.local is git-ignored.
# Nothing here is needed to build or serve the public site — only the admin.
# ---------------------------------------------------------------------------

# PostgreSQL. The password is the one you set when you installed PostgreSQL.
# `npm run db:setup` creates the database itself, so it does not need to exist.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/rti_admin

# Signs the admin session cookie. Any 32+ random characters. Changing it signs
# everyone out, which is also how you revoke every session at once.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
