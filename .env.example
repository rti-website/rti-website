# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill it in. .env.local is git-ignored.
# Nothing here is needed to build or serve the public site — only the admin.
# ---------------------------------------------------------------------------

# PostgreSQL. The password is the one you set when you installed PostgreSQL.
# `npm run db:setup` creates the database itself, so it does not need to exist.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/rti_admin

# Signs the admin session cookie. Any 32+ random characters. Changing it signs
# everyone out, which is also how you revoke every session at once.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Form notifications — src/lib/mail.ts and src/app/api/leads/route.ts
#
# Leave these blank and the site still works: a contact form submission is
# saved to the `leads` table and shows up in the admin, the visitor gets their
# thank-you, and the server logs that nobody was emailed. Fill them in and the
# same submission also lands in an inbox.
#
# SMTP_USER is a mailbox you own; SMTP_PASS is an app password, never the
# account's own password. For Google Workspace that means turning on 2-step
# verification and creating an app password for this server.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# What the notification is sent AS. Defaults to SMTP_USER when blank. Use an
# address on a domain whose SPF record allows this sender, or it goes to spam.
MAIL_FROM=

# Who gets told about a new enquiry. ONE address.
# Dev server: rizwan.haider@99technologies.com (testing). Production should be
# whoever actually answers enquiries — do not let a tester's inbox ship.
LEAD_NOTIFY_TO=

# ---------------------------------------------------------------------------
# How many processes prerender pages during `npm run build`.
#
# Leave BLANK on a machine with memory to spare: Next then uses one worker per
# core, which is what you want. Set it on a box where that does not fit.
#
# One worker peaks around 740 MB building this site. Multiply by the core count
# and compare against the "available" column of `free -h` BEFORE raising it —
# a build that exceeds available memory does not fail, it swaps, and pages
# start blowing past Next's 60-second render timeout one at a time.
#
# Dev server (8 cores, ~2.9 GB available, swap already full): 3.
# ---------------------------------------------------------------------------
BUILD_CPUS=
