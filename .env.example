# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill it in. .env.local is git-ignored.
# Nothing here is needed to build or serve the public site — only the admin.
# ---------------------------------------------------------------------------

# PostgreSQL. The password is the one you set when you installed PostgreSQL.
# `npm run db:setup` creates the database itself, so it does not need to exist.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/rti_admin

# Signs the admin session cookie. Any 32+ random characters. Changing it signs
# everyone out, which is also how you revoke every session at once.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Form notifications — src/lib/mail.ts and src/app/api/leads/route.ts
#
# Leave these blank and the site still works: a contact form submission is
# saved to the `leads` table and shows up in the admin, the visitor gets their
# thank-you, and the server logs that nobody was emailed. Fill them in and the
# same submission also lands in an inbox.
#
# SMTP_USER is a mailbox you own; SMTP_PASS is an app password, never the
# account's own password. For Google Workspace that means turning on 2-step
# verification and creating an app password for this server.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# What the notification is sent AS. Defaults to SMTP_USER when blank. Use an
# address on a domain whose SPF record allows this sender, or it goes to spam.
MAIL_FROM=

# Sender of the automatic drop off email residential enquiries get
# (src/data/emails.ts). Falls back to MAIL_FROM. Replies go to LEAD_NOTIFY_TO.
CUSTOMER_MAIL_FROM=

# Who gets told about a new enquiry. ONE address.
# Dev server: rizwan.haider@99technologies.com (testing). Production should be
# whoever actually answers enquiries — do not let a tester's inbox ship.
LEAD_NOTIFY_TO=

# Optional CC on every notification, comma separated.
LEAD_NOTIFY_CC=
# Optional overrides (src/lib/mail.ts notifyRecipients). First one set wins:
# by audience, then by form, then LEAD_NOTIFY_TO / LEAD_NOTIFY_CC.
# 6 Oct 2026: business enquiries go to Christine with Usman in CC.
LEAD_NOTIFY_TO_COMMERCIAL=
LEAD_NOTIFY_CC_COMMERCIAL=
LEAD_NOTIFY_TO_RESIDENTIAL=
LEAD_NOTIFY_CC_RESIDENTIAL=
LEAD_NOTIFY_TO_QUOTE=
LEAD_NOTIFY_CC_QUOTE=
LEAD_NOTIFY_TO_PICKUP=
LEAD_NOTIFY_CC_PICKUP=
LEAD_NOTIFY_TO_CONTACT=
LEAD_NOTIFY_CC_CONTACT=

# ---------------------------------------------------------------------------
# How many processes prerender pages during `npm run build`.
#
# Leave BLANK on a machine with memory to spare: Next then uses one worker per
# core, which is what you want. Set it on a box where that does not fit.
#
# One worker peaks around 740 MB building this site. Multiply by the core count
# and compare against the "available" column of `free -h` BEFORE raising it —
# a build that exceeds available memory does not fail, it swaps, and pages
# start blowing past Next's 60-second render timeout one at a time.
#
# Dev server (8 cores, ~2.9 GB available, swap already full): 3.
# ---------------------------------------------------------------------------
BUILD_CPUS=

# ---------------------------------------------------------------------------
# Visitor identification (docs/visitor-identification/README.md, db/018).
# Everything stays off until VISITOR_CAPTURE=on. Never put real values here.
# ---------------------------------------------------------------------------
# on | off. The page tracker, /api/e/ and the privacy policy paragraph.
VISITOR_CAPTURE=off
# on | off. The job timer (digest, weekly report, retention). ONE app only.
VISITOR_JOBS=off
# ipapi.is API key.
IPAPI_KEY=
# Any 32+ random characters. Generate:  openssl rand -hex 32
# Changing it means every IP is looked up again once.
IP_HASH_SALT=
# Office and team VPN ranges never looked up, CIDR, comma separated.
VISITOR_EXCLUDED_IPS=
# Digest, weekly report and warnings. Aaqib only until sign off.
VISITOR_DIGEST_TO=aaqib@99technologies.com
# Roles that see Admin -> Visitors and Visitor leads (empty = none).
VISITOR_ADMIN_ROLES=administrator
# Also these people, whatever their role (comma separated emails).
VISITOR_ADMIN_EMAILS=
# The proxy header with the client IP. Our nginx sets X-Forwarded-For.
CLIENT_IP_HEADER=x-forwarded-for
# on: log which IP headers arrive (masked). For checking the proxy only.
VISITOR_DEBUG_IP=off
# Not used: the EU/UK check uses the DB-IP country file (npm run geoip:update).
MAXMIND_LICENSE_KEY=

# Snitcher (management, 30 Oct 2026; src/components/client/SnitcherTag.tsx):
# the profile id from Snitcher's installation email. Loads only after
# Analytics consent. Empty = off. Rebuild after changing it.
SNITCHER_PROFILE_ID=
