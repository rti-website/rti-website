node_modules
.next
out
tsconfig.tsbuildinfo

# Secrets. .env.example is committed; .env.local never is.
.env
.env.local

# Generated by Next on every dev run
next-env.d.ts

# Generated artefacts
build.log
*.log
data/redirects.nginx.conf
data/_redirects

# ---------------------------------------------------------------------------
# THE MEDIA LIBRARY IS NOT IN GIT, AND THAT IS A DEPLOYMENT STEP, NOT A
# DECISION TO FORGET.
#
#   var/uploads/        every image the admin has uploaded, plus the images the
#                       WordPress import pulled in from Google's CDN. 265 MB.
#                       The CDN links they came from rot — several are already
#                       dead — so this folder is NOT reproducible by re-running
#                       the import. Back it up, and rsync it to the server.
#
#   public/wp-content/  the legacy WordPress uploads, kept at their original
#                       paths (CLAUDE.md rule 8). Re-creatable by re-running
#                       `npm run wp:import` while the old site is still up.
#
# Hundreds of megabytes of binaries make every clone painful and every diff
# useless. See "Deploying" in README.md.
# ---------------------------------------------------------------------------
var/
public/wp-content/

# OS noise
.DS_Store
Thumbs.db
