{
  "name": "rti-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "node scripts/build-redirects.mjs && next dev",
    "build": "node scripts/build-redirects.mjs && next build",
    "build:one": "next build --debug-build-paths",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "oxlint",
    "redirects:build": "node scripts/build-redirects.mjs",
    "verify:redirects": "node scripts/verify-redirects.mjs",
    "verify:static": "node scripts/check-static.mjs",
    "verify:parity": "node scripts/crawl-diff.mjs",
    "verify:all": "npm run lint && npm run verify:static && npm run verify:assets && npm run verify:redirects && npm run verify:parity",
    "measure": "node scripts/measure-service-pages.mjs",
    "verify:overlaps": "node scripts/check-overlaps.mjs",
    "verify:assets": "node scripts/check-assets.mjs",
    "verify:links": "node scripts/check-links.mjs",
    "db:setup": "node scripts/db-setup.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "user:add": "node scripts/make-user.mjs",
    "check:admin": "node scripts/check-admin.mjs",
    "wp:import": "node scripts/wp-import.mjs",
    "check:clickable": "node scripts/check-clickable.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@mdx-js/loader": "^3",
    "@mdx-js/react": "^3",
    "@next/mdx": "16.3.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-character-count": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/static-renderer": "^3.31.3",
    "next": "16.3.5",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/mdx": "^2",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "oxlint": "^1.83.0",
    "playwright": "^1.63.0",
    "typescript": "^7"
  }
}
